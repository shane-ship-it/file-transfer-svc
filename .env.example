# Azure Blob Storage Configuration
AZURE_STORAGE_URL="https://cilsteststorage01.blob.core.windows.net"
AZURE_SAS_TOKEN="si=FullAccess"
AZURE_CONTAINER_NAME="lspunpoc"

# Destination Configuration
DESTINATION_TYPE=local_fs  # Options: local_fs, gcp_storage
LOCAL_SAVE_PATH=./downloads

# GCP Configuration (optional, for GCP destination)
# GCP_PROJECT_ID=my-project-id
# GCP_BUCKET_NAME=my-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Transfer Configuration
BATCH_SIZE=10
RETRY_ATTEMPTS=3
RETRY_DELAY=5
CONCURRENT_DOWNLOADS=5
OVERWRITE_EXISTING=false

# API Configuration (for Cloud Run)
PORT=8080
# API_KEY=optional-api-key-for-authentication